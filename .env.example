# Accounting provider: "zoho" (more coming later)
ACCOUNTING_PROVIDER=zoho

# Zoho Books credentials
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_BASE_URL=https://www.zohoapis.com

# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model to use (e.g. "gpt-4o", "claude-sonnet-4-20250514")
LLM_MODEL=gpt-4o
